// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Barber {
  id          String    @id @default(cuid())
  name        String    @unique
  image       String?   // Public URL: a static /barbers/... file or /api/barbers/{id}/image
  imageData   Bytes?    // Uploaded photo bytes, served by /api/barbers/{id}/image
  imageType   String?   // MIME type of imageData, e.g. image/jpeg
  // false: the barber follows the default WORKING_PERIODS (lib/schedule.ts).
  // true: workingPeriods is the barber's own week (empty = never works).
  customSchedule Boolean @default(false)
  bookings    Booking[]
  workingPeriods BarberWorkingPeriod[]
  timeOff     TimeOff[]
}

// One working interval of a barber's week; several per day model breaks.
model BarberWorkingPeriod {
  id        String @id @default(cuid())
  barberId  String
  dayOfWeek Int    // JavaScript day: Sunday = 0
  startTime String // "HH:MM"
  endTime   String // "HH:MM"
  barber    Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId])
}

// Days off for one barber, or the whole shop when barberId is null.
model TimeOff {
  id        String   @id @default(cuid())
  barberId  String?
  startDate String   // YYYY-MM-DD, inclusive
  endDate   String   // YYYY-MM-DD, inclusive
  reason    String?
  createdAt DateTime @default(now())
  barber    Barber?  @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([endDate])
}

model Service {
  id          String    @id @default(cuid())
  name        String    @unique // π.χ. "Κούρεμα"
  duration    Int       // Διάρκεια σε λεπτά (π.χ. 30)
  price       Float     // Τιμή
  bookings    Booking[]
}

enum BookingStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model ScheduleException {
  id          String   @id @default(uuid())
  date        DateTime // The specific day affected
  barberName  String?  // If null, applies to the whole shop. Otherwise, specific barber.
  type        String   // "BLOCK_SLOT" (blocks a specific hour) or "FORCE_OPEN" (opens a Monday) or "FORCE_CLOSE"
  slotTime    String?  // e.g., "14:30" (only used if type is BLOCK_SLOT)
  createdAt   DateTime @default(now())

  @@index([date])
}

// Single row with id "admin" (see ADMIN_CREDENTIAL_ID in lib/admin-auth.ts).
model AdminCredential {
  id           String   @id @default("admin")
  passwordHash String
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model Booking {
  id          String   @id @default(cuid())
  cancelToken String   @unique @default(cuid())
  createdAt   DateTime @default(now())
  startTime   DateTime // Η ώρα έναρξης του ραντεβού
  endTime     DateTime // Η ώρα λήξης (startTime + duration)
  status      BookingStatus @default(PENDING)

  // Στοιχεία Πελάτη
  customerName  String
  customerPhone String
  customerEmail String?
  noShow       Boolean @default(false)
  notes        String?  // Optional comment the customer leaves when booking
  reminderSentAt DateTime? // Day-before reminder email; cleared when the booking moves

  // Σχέσεις
  barberId    String
  barber      Barber   @relation(fields: [barberId], references: [id])
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id])

  @@index([startTime])
  @@index([barberId, startTime])
}

// Shop-side profile of a customer, keyed by the normalized mobile number
// that every booking stores. Name and email live on the bookings.
model Customer {
  phone         String   @id // +3069XXXXXXXX
  notes         String?  // Private notes for the shop, e.g. preferences
  blocked       Boolean  @default(false) // Cannot book online
  blockedReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Fixed-window request counters shared by every serverless instance.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}
